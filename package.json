{
  "name": "clipboard-manager",
  "version": "1.2.1",
  "description": "Windows 剪贴板历史管理工具",
  "main": "./out/main/index.js",
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "predev": "npm run build:native",
    "prebuild": "npm run build:native",
    "predist": "npm run build:native",
    "prepack": "npm run build:native",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "tsx --test tests/**/*.test.ts",
    "preview": "electron-vite preview",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-vite build && electron-builder --win"
  },
  "keywords": [
    "clipboard",
    "history",
    "windows"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "fflate": "^0.8.2",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "^5.4.21"
  }
}
